# Existing Telegram / Google / Yandex settings
BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEETS_ID=your_google_spreadsheet_id
GOOGLE_CREDENTIALS_JSON={"type":"service_account"}
YANDEX_DISK_TOKEN=your_yandex_disk_token

# Access control
# Whitelist is disabled: all users can use /start and /admin.

# VK settings for future adapter
VK_GROUP_TOKEN=your_vk_group_token
VK_GROUP_ID=123456789
VK_CONFIRMATION_CODE=abc123
VK_SECRET_KEY=your_secret

# Runtime settings
SESSION_STORE=memory
PORT=3000
LOG_LEVEL=info